{
  "name": "weather-station-cards",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Lovelace cards for Home Assistant weather stations",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --format=esm --target=es2022 --outfile=dist/weather-station-cards.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
